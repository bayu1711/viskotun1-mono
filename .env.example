# Required for multimodal paper extraction and clinical assistant Q&A
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Project settings for Cloud Run deployment
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
FIRESTORE_EMULATOR_HOST=
