# ==============================================================================
# ViskotuN1 — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Get your Gemini API key at: https://aistudio.google.com/
# ==============================================================================

# Required for multimodal paper extraction and clinical assistant Q&A (Google AI Studio keys)
# Supports comma-separated keys for automatic round-robin and 429 failover:
GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Default used by the code when unset:
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Google Cloud Text-to-Speech for the voice coach (falls back to browser speech)
GOOGLE_TTS_API_KEY=

# Optional: Google Cloud Project settings for Cloud Run deployment
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
FIRESTORE_DATABASE_ID=viskotun1-database
FIRESTORE_EMULATOR_HOST=

# ------------------------------------------------------------------------------
# Server-side identity and admin access
# ------------------------------------------------------------------------------
# Project whose Firebase ID tokens the API accepts (defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=
# Admins: Firebase uids and/or verified emails, comma-separated.
# A Firebase custom claim { admin: true } also grants admin.
ADMIN_UIDS=
ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# Production safety switches (leave unset in production)
# ------------------------------------------------------------------------------
# In production, writes fail loudly when Firestore/GCS are unavailable. Set to true only for a
# local Docker run without Google Cloud, where in-memory storage is acceptable.
ALLOW_MEMORY_FALLBACK=
# In production, extraction never returns the canned demo routine. Set to true only for a demo deploy.
ENABLE_DEMO_EXTRACTION=

# Optional: Firebase Client SDK configuration for live Google Sign-In popups
# From Firebase Console -> Project Settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Private / Local Gemma Endpoint (Ollama or Vertex AI Model Garden)
# If provided, assistant Q&A will query your private Gemma 2 model
GEMMA_ENDPOINT_URL=
GEMMA_MODEL=gemma2:2b
