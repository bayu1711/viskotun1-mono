# ==============================================================================
# ViskotuN1 — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Get your Gemini API key at: https://aistudio.google.com/
# ==============================================================================

# Required for multimodal paper extraction and clinical assistant Q&A
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: Google Cloud Project settings for Cloud Run deployment
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
FIRESTORE_DATABASE_ID=viskotun1-database
FIRESTORE_EMULATOR_HOST=

# Optional: Firebase Client SDK configuration for live Google Sign-In popups
# From Firebase Console -> Project Settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Private / Local Gemma Endpoint (Ollama or Vertex AI Model Garden)
# If provided, assistant Q&A will query your private Gemma 2 model
GEMMA_ENDPOINT_URL=
GEMMA_MODEL=gemma2:2b
